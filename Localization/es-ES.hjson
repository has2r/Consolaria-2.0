			UtensilPoker: {
				DisplayName: Perforador de Utensilios
				Tooltip:
					'''
					Haz clic derecho para preparar hasta cinco tenedores arrojadizos
					Los tenedores se quedan clavados en los enemigos, haciéndolos sangrar
					El uso excesivo de esta arma te agota, reduciendo enormemente su daño
					Matar enemigos recupera parte de tu agotamiento
					'''
			}

			Chocoplotion: {
				DisplayName: Chocoexplosión
				Tooltip:
					'''
					Salta hacia un enemigo y explota en gotas de chocolate
					El uso excesivo de esta arma te agota, reduciendo enormemente su daño
					Matar enemigos recupera parte de tu agotamiento
