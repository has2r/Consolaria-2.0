		NPCs: {
			AlbinoAntlion: {
				DisplayName: Hormiga León Albina
				Bestiary: Especie de hormiga león con una rara mutación donde muestra aún más agresividad, tal vez para compensar la sensibilidad de su caparazón a la luz solar.
			}

			AlbinoCharger: {
				DisplayName: Cargador de Hormigas León Albino
				Bestiary: En raras ocasiones, algunos soldados hormiga león mutan, pierden su color y se vuelven incluso más feroces que sus hermanos.
			}

			ArchDemon: {
				DisplayName: Archidemonio
				Bestiary: Los demonios particularmente poderosos viven lo suficiente como para que su cuerpo se convierta en una cáscara marchita.
			}

			ArchWyvernHead: {
				DisplayName: Archiguiverno
				Bestiary: Las leyendas dicen que los guivernos son capaces de escupir fuego. Lo que no dicen es que pocos crecen lo suficiente como para adquirir tal poder.
			}

			ArchWyvernBody1.DisplayName: Archiguiverno
			ArchWyvernBody2.DisplayName: Archiguiverno
			ArchWyvernBody3.DisplayName: Archiguiverno
			ArchWyvernLegs.DisplayName: Archiguiverno
			ArchWyvernTail.DisplayName: Archiguiverno
			BigEgg.DisplayName: Huevo de Lepus
			ChocolateEgg.DisplayName: Huevo de chocolate

			DisasterBunny: {
				DisplayName: Conejito Desastre
				Bestiary: Estas criaturas de ojos saltones, desastrosas engendros del gigante rabioso, morderán cualquier cosa que encuentren.
			}

			Lepus: {
				DisplayName: Lepus
				Bestiary: Como si su tamaño no fuera suficientemente problemático, este conejo puede reproducirse a través de huevos coloridos, repartidos por todo el mundo en primavera para que los tontos los recojan.

				BossChecklistIntegration: {
					SpawnInfo: Usando [i:5642]
					DespawnMessage: ¡Lepus salta hacia el atardecer!
				}
			}

			SmallEgg.DisplayName: Huevo de Lepus

			Ocram: {
				DisplayName: Ocram
				Bestiary: Este demonio arruinado y olvidado, que alguna vez fue el poderoso Emperador de las Tinieblas, ahora busca venganza contra todos los habitantes de la superficie.

				BossChecklistIntegration: {
					SpawnInfo: Usando [i:5643] de noche
					DespawnMessage: Ocram desaparece entre las sombras!
				}
			}

			ServantofOcram: {
				DisplayName: Sirviente de Ocram
				Bestiary: Criaturas malvadas manifestadas por Ocram, creadas para proteger a su amo por cualquier medio necesario.
			}

			TurkorNeck.DisplayName: Cuello de Turkor

			TurkortheUngrateful: {
				DisplayName: Turkor el Desagradecido
				Bestiary: Esta monstruosidad, que existe por puro despecho, se dedica a una venganza anual contra aquellos que se atreven a darle un mordisco al pavo de Acción de Gracias.

				BossChecklistIntegration: {
					EntryName: Turkor el Desagradecido
					SpawnInfo: Usando [i:5641] después de invocar a un pavo como mascota
					DespawnMessage: Turkor el desagradecido se escapa del plato!
				}
			}

			TurkortheUngratefulHead.DisplayName: Cabeza de Turkor el Desagradecido

			DragonHornet: {
				DisplayName: Avispón Dragón
				Bestiary: Parientes de los avispones comunes, estos insectos desarrollaron una apariencia inusual para ahuyentar a los enemigos. Si eso no fuera suficiente, los aguijones venenosos deberían hacer el trabajo.
			}

			DragonSkull: {
				DisplayName: Calavera de Dragón
				Bestiary: Tocadas por hechizos nigrománticos, las cabezas de antiguos reptiles ahora se aprovechan de los vivos y comparten su maldición con sus víctimas.
			}

			DragonSnatcher: {
				DisplayName: Atrapadora Dragón
				Bestiary: Esta especie de atrapadora aprendió a reutilizar los aguijones de los avispones que caían presa de él para cazar objetivos más grandes.
			}

			FleshAxe: {
				DisplayName: Hacha de Carne
				Bestiary: Hechizada por el colectivo carmesí, esta arma se mueve y corta a sus enemigos por su propia voluntad.
			}

			FleshMummy: {
				DisplayName: Momia de Carne
				Bestiary: Con las arenas transformadas por fuerzas externas, aquellos que descansan en el desierto, ya sean buenos o malos, ahora se levantan para mutilar y matar.
			}

			FleshSlime: {
				DisplayName: Slime de Carne
				Bestiary: Impregnados del poder del carmesí, estos limos pueden esparcir sus excrementos.
			}

			GiantAlbinoCharger: {
				DisplayName: Cargador de Hormigas León Albino Gigante
				Bestiary: Es probable que algunos soldados hormiga león muten, pierdan su color y se vuelvan aún más feroces que sus hermanos.
			}

			MythicalWyvernHead: {
				DisplayName: Guiverno Mitológico
				Bestiary: Seres legendarios, estos solitarios guivernos solo aparecen en una época determinada del año.
			}

			MythicalWyvernBody.DisplayName: Guiverno Mitológico
			MythicalWyvernBody2.DisplayName: Guiverno Mitológico
			MythicalWyvernBody3.DisplayName: Guiverno Mitológico
			MythicalWyvernLegs.DisplayName: Guiverno Mitológico
			MythicalWyvernTail.DisplayName: Guiverno Mitológico

			Orca: {
				DisplayName: Orca
				Bestiary: Como no se ven ballenas en los océanos, estos depredadores blancos y negros cazarán cualquier otra cosa... ¡incluido tú!
			}

			ShadowHammer: {
				DisplayName: Martillo Sombrío
				Bestiary: Magia a través del odio puro a la corrupción, esta arma intenta aplastar cualquier cosa que respire.
			}

			ShadowMummy: {
				DisplayName: Momia Sombría
				Bestiary: Con las arenas transformadas por fuerzas externas, aquellos que descansan en el desierto, ya sean buenos o malos, ahora se levantan para mutilar y matar.
			}

			ShadowSlime: {
				DisplayName: Slime Sombrío
				Bestiary: Impregnados del poder de la corrupción, estos limos pueden esparcir sus excrementos.
			}

			SpectralElemental: {
				DisplayName: Elemental Espectral
				Bestiary: A veces, los espíritus de luz liberados transforman los elementales del caos en seres más poderosos, dándoles la capacidad de entrar y salir del reino material a voluntad mientras colocan runas espectrales explosivas.
			}

			SpectralGastropod: {
				DisplayName: Gasterópodo Espectral
				Bestiary: Estos limos poseídos por espíritus de luz, que alguna vez fueron gasterópodos comunes y corrientes, pueden escupir bolas de energía luminosa concentrada.
			}

			SpectralMummy: {
				DisplayName: Momia Espectral
				Bestiary: La desbordante energía luminosa de estas momias hace que sus destrozados cuerpos sean muy inestables.
			}

			VampireMiner: {
				DisplayName: Vampiro Minero
				Bestiary: La evidencia indica que algunos espeleólogos fueron mordidos por murciélagos vampiros antes de fallecer... Ahora sus restos podridos están en busca de sangre.
			}

			McMoneypants: {
				DisplayName: Don Pantalones Ricachones
				Bestiary: Extravagante y carismático, Don pantalones ricachones es un excelente barón dispuesto a hacer la vida más fácil a cualquiera... ¡Por un precio!
				AlreadyInvested1: No existe suficiente oro, pero hoy ya he tenido suficiente de ti.
				AlreadyInvested2: Lo siento, pero mis bolsillos ya están llenos.
				AlreadyInvested3: Estás suficientemente afortunado por hoy.
				AlreadyInvested4: Ahora, no seas demasiado codicioso a menos que quieras terminar como ese tipo griego.
				PlayerHasNoMoney1: ¡Lo siento, no puedo dar crédito! Vuelve cuando seas un poco... más rico.
				PlayerHasNoMoney2: No estoy dirigiendo una organización benéfica, sabes...
				PlayerHasNoMoney3: Muéstrame el dinero y luego hablaremos.
				PlayerHasNoMoney4: No, no se puede pagar con vales.
				FirstTimeInvested1: ¡Oro Ferragamo!
				FirstTimeInvested2: Se ha llegado a un acuerdo, arriba va tu suerte.
				FirstTimeInvested3: Hoy es tu dia de suerte.
				FirstTimeInvested4: ¡Una gran inversión! ¡Afortunado que eres!
				WhenInvested1: El tiempo es dinero. ¡Así que vuelve mañana para gastar un poco!
				WhenInvested2: Créeme, no es un esquema Ponzi.
				WhenInvested3: Multiplicando dinero en curso...
				WhenInvested4: ¿Cuántas veces tengo que decirlo? ¡Sin reembolsos!
				WhenInvested5: ¿Donde esta mi pluma? ¡No me digas que la tomaste después de firmar el contrato!
				WhenInvested6: ¡Un placer hacer negocios! Volveré en un día para que podamos renovar nuestro trato.
				WhenInvested7: ¡Por última vez, para de preguntarme sobre inflación!
				WhenInvested8: ¡Bombéalo! ¡No, tíralo! Oh, eres tú otra vez.
				Quote1: Sinceramente, un centavo por mis pensamientos no es mucho.
				Quote2: Si tuviera cinco centavos por cada monstruo que vi anoche, sería aún más rico y estaría un poco menos asustado.
				Quote3: ¡Esos malditos slimes siguen intentando tragarse mis monedas!
				Quote4: Si el dinero hace girar al mundo, este lugar parece muy pobre. ¡Cambiémoslo!
				Quote5: ¡Me siento tan limpio, como una máquina de hacer dinero!
				Quote6: ¿Sabes lo que me gusta del oro? ¡Tengo mucho!
				Quote7: Oye, una cosa que puedo prometerte es que nunca les pido a mis clientes que me juzguen por mis ganadores. Les pido que me juzguen por mis perdedores, porque tengo muy pocos.
				Quote8: Cuando esos raros bloques de tierra suban de precio, ¡voy a ganar millones!
				Quote9: ¿Mi consejo financiero? No dispares tus monedas con esa horrible arma.
				Quote10: ¿Bitcoin? ¿Por qué alguna vez ganaría una moneda?
			}

			AlbinoSwarmer: {
				Bestiary: Puede que las hormigas león albinas no sean aptas para camuflarse en las dunas, pero se dice que la vista de su pálida silueta infunde un miedo primario en sus presas.
				DisplayName: Enjambrador Albino
			}

			GiantAlbinoSwarmer: {
				Bestiary: Puede que las hormigas león albinas no sean aptas para camuflarse en las dunas, pero se dice que la vista de su pálida silueta infunde un miedo primario en sus presas.
				DisplayName: Enjambrador Albino Gigante
			}
		}

