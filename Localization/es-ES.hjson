		Configs: {
			ConsolariaConfig: {
				DisplayName: Configuración

				Headers: {
					SeasonalEvents: Eventos Estacionales
					Miscellaneous: Misceláneos
					WorldGeneration: Generación de mundo
				}

				easterEnabled: {
					Label: Restringir el Contenido Estacional por Fecha del Sistema (Pascua)
					Tooltip:
						'''
						Si se habilita los elementos y enemigos relevantes solo aparecerán durante la Pascua.
						Abril 1 - Abril 30
						'''
				}

				thanksgivingEnabled: {
					Label: Restringir el Contenido Estacional por Fecha del Sistema (Acción de gracias)
					Tooltip:
						'''
						Si se habilita los elementos y enemigos relevantes solo aparecerán durante la Acción de gracias
						Noviembre 1 - Noviembre 30
						'''
				}

				smallEventsEnabled: {
					Label: Restringir el Contenido Estacional por Fecha del Sistema (Otros eventos)
					Tooltip: Si se habilita los elementos y enemigos relevantes solo aparecerán durante los festivos correspondientes o usando el Hueso de los deseos
				}

				vanillaBossMusicEnabled: {
					Label: Música de Vanilla para Jefes de Consolaria
					Tooltip: Si está habilitado, la banda sonora personalizada será reemplazada por temas utilizados originalmente en versiones de consola
				}

				tizonaZenithIntegrationEnabled: {
					Label: Integración de Tizona en la Zenith
					Tooltip: Si está habilitado, la Tizona se agregará a la receta de elaboración de la Zenith y sus proyectiles
				}

				oktoberLocksEnabled: {
					Label: Objeto de Vanidad Trenzas de Oktober
					Tooltip: Si está habilitado, las trenzas de Oktober serán disponibles para comprar con el Buhonero durante Oktoberfest
				}

				mythicalWyvernKiteVanillaDropruleEnabled: {
					Label: Obtención Vanilla de Cometa de Guiverno Mitológico
					Tooltip: Si está habilitado, la cometa de guiverno mitológico tendra un 4% de probabilidad de ser soltada por un Guiverno Mitológico durante los dias ventosos en vez de ser obtenida de los sobres rojos
				}

				heartbeatariaIntegrationEnabled: {
					Label: Integración con Heartbeataria Mod
					Tooltip: Si está habilitado, los objetos exclusivos de Heartbeataria se podrán obtener de los sobres rojosfrom Red Envelope
				}

				originalAncientHeroSetRecipeEnabled: {
					Label: Receta Original del Conjunto de Héroe Antiguo
					Tooltip: Si está habilitado, el conjunto de héroe antiguo se podra crear usando seda y hilo en un telar en vez de con el fulgor
				}

				genderRestrictShopEnabled: {
					Label: Restringir Conjunto de George y Conjunto Fabuloso por Género del Jugador
					Tooltip:
						'''
						Si está habilitado, los conjuntos relevantes solo aparecerán en la tienda del Buhonero durante la luna de sangre si el jugador tiene un cierto género
						Hombre - Conjunto de George
						Mujer - Cojunto Fabuloso
						'''
				}

				pyramidEnabled: {
					Label: Pirámide Garantizada
					Tooltip: Si está habilitado, al menos una pirámide se generará siempre en el mundo
				}

				pyramidMessageLoot: {
					Label: Botín Especial de Pirámide
					Tooltip: Si está habilitado, un mensaje especial aparecera en la segunda habitación de la pirámide
				}
			}
		}

