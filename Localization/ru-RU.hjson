					'''
			}

			SeraphimHelmet: {
				DisplayName: Шлем серафима
				Tooltip:
					'''
					Снижает весь урон, кроме лучезарного, на 20%
					Увеличивает лучезарный урон на 15%
					Уменьшает расход маны на 20%
					Увеличивает максимальный запас маны на 60 
					Исцеляющие заклинания восстанавливают дополнительно 2 ед. здоровья
					'''
				SetBonus: Нажатие клавиши «{$Mods.ThoriumMod.Keybinds.ArmorAbility.DisplayName}» активирует «Ангельские объятия», даруя бесконечный полёт и исцеляя союзников при касании на 4 секунды
			}

			SeraphimLegs: {
				DisplayName: Ботфорты серафима
