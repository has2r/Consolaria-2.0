			}

			ArchWyvernBody1.DisplayName: Архививерна
			ArchWyvernBody2.DisplayName: Архививерна
			ArchWyvernBody3.DisplayName: Архививерна
			ArchWyvernLegs.DisplayName: Архививерна
			ArchWyvernTail.DisplayName: Архививерна
			BigEgg.DisplayName: Яйцо Лепуса
			ChocolateEgg.DisplayName: Шоколадное яйцо

			DisasterBunny: {
				DisplayName: Пасхальный заяц
				Bestiary: Чудовищное порождение гигантского кролика. Эти пучеглазые создания кусают всё, что встречается на их пути.
			}

			Lepus: {
				DisplayName: Лепус
				Bestiary: Как будто его собственных размеров недостаточно, этот заяц способен размножаться с помощью разноцветных яиц, которые весной оказываются повсюду, ожидая, что их подберут доверчивые глупцы.

				BossChecklistIntegration: {
					SpawnInfo: Используйте [i:Consolaria/SuspiciousLookingEgg].
					DespawnMessage: Лепус упрыгивает туда, откуда пришёл.
				}
			}

			SmallEgg.DisplayName: Яйцо Лепуса

			Ocram: {
				DisplayName: Окрам
				Bestiary: Этот забытый, гниющий демон, когда-то звавшийся Императором тьмы, жаждет мести всем обитателям поверхности.

				BossChecklistIntegration: {
					SpawnInfo: Используйте [i:Consolaria/SuspiciousLookingSkull] ночью.
					DespawnMessage: Окрам обратно исчезает в тени...
				}
			}

			ServantofOcram: {
				DisplayName: Прислужник Окрама
				Bestiary: Эти злобные существа, порождённые Окрамом, готовы защищать своего хозяина любыми способами.
			}

			TurkorNeck.DisplayName: Шея Индейкора

			TurkortheUngrateful: {
				DisplayName: Индейкор Неблагодарный
				Bestiary: Это чудовище, существующее на чистой злобе, ежегодно проводит вендетту против тех, кто осмеливается откусить кусочек индейки на День благодарения.

				BossChecklistIntegration: {
					EntryName: Индейкор Неблагодарный
					SpawnInfo: Используйте [i:Consolaria/CursedStuffing], пока за вами следует питомец-индейка
					DespawnMessage: Индейкор Неблагодарный сбегает с обеденной тарелки!
				}
			}

			TurkortheUngratefulHead.DisplayName: Голова Индейкора Неблагодарного

			DragonHornet: {
				DisplayName: Драконий шершень
				Bestiary: Являясь родственниками обычных шершней, эти сменили свой облик, чтобы отпугивать врагов. Если же этого недостаточно, то их ядовитые жала закончат дело.
			}

			DragonSkull: {
				DisplayName: Драконий череп
				Bestiary: Затронутые некромантией, головы древних рептилий теперь охотятся на живых, разделяя проклятие со своими жертвами.
			}

			DragonSnatcher: {
				DisplayName: Драконий хвататель
				Bestiary: Этот вид хватателей научился использовать жала шершней, ставших их жертвами, чтобы охотиться на более крупные цели. 
			}

			FleshAxe: {
				DisplayName: Мясной топор
				Bestiary: Заколдованное сущностью багрянца, этот топор передвигается и разрубает своих врагов по собственной воле.
			}

			FleshMummy: {
				DisplayName: Мясная мумия
				Bestiary: С трансформацией песков внешними силами те, кто был захоронен в пустыне, будь то добрые или злые, поднимаются из могилы, чтобы калечить и убивать.
			}

			FleshSlime: {
				DisplayName: Мясной слизень
				Bestiary: Пропитанные силой багрянца, эти слизни могут разбрасывать свои выделения. 
			}

			GiantAlbinoCharger: {
				DisplayName: Большой муравьиный налётчик-альбинос
				Bestiary: Иногда муравьиные воители мутируют, теряя свою окраску и становясь более свирепыми, чем их собратья по рою.
			}

			MythicalWyvernHead: {
				DisplayName: Мифическая виверна
				Bestiary: Эти легендарные существа, виверны-затворники, появляются лишь в определённое время года. 
			}

			MythicalWyvernBody.DisplayName: Мифическая виверна
			MythicalWyvernBody2.DisplayName: Мифическая виверна
			MythicalWyvernBody3.DisplayName: Мифическая виверна
			MythicalWyvernLegs.DisplayName: Мифическая виверна
			MythicalWyvernTail.DisplayName: Мифическая виверна

			Orca: {
				DisplayName: Касатка
				Bestiary: Так как в этих океанах киты не водятся, эти чёрно-белые хищники охотятся на всё, что движется... включая вас!
			}

			ShadowHammer: {
				DisplayName: Теневой молот
				Bestiary: Заколдованное чистой ненавистью искажения, этот молот беспорядочно мечется от места к месту, пытаясь прибить всё, что дышит.
			}

			ShadowMummy: {
				DisplayName: Теневая мумия
				Bestiary: С трансформацией песков внешними силами те, кто был захоронен в пустыне, будь то добрые или злые, поднимаются из могилы, чтобы калечить и убивать.
			}

			ShadowSlime: {
				DisplayName: Теневой слизень
				Bestiary: Пропитанные силой Порчи, эти слизни могут разбрасывать свои выделения.
			}

			SpectralElemental: {
				DisplayName: Спектральный элементаль
				Bestiary: Иногда пробудившиеся духи света превращают элементалей хаоса в более могущественных существ, позволяя им проходить сквозь ткань реальности и размещать взрывные спектральные руны.
			}

			SpectralGastropod: {
				DisplayName: Спектральный брюхоног
				Bestiary: Когда-то они были самыми обычными брюхоногим. Теперь эти слизни, одержимые духами света, могут плеваться в своих врагов сферами концентрированной эссенции.
			}

			SpectralMummy: {
				DisplayName: Спектральная мумия
				Bestiary: Энергия света, переполняющая этих мумий, сделала их уже изношенные тела ещё более нестабильными.
			}

			VampireMiner: {
				DisplayName: Шахтёр-вампир
				Bestiary: Похоже, некоторых шахтёров перед смертью успели покусать летучие мыши-вампиры... И теперь их гнилые останки жаждут крови.
			}

			McMoneypants: {
				DisplayName: Мак МаниПэнтс
				Bestiary: Яркая и харизматичная личность, Мак МаниПэнтс - прекрасный богатей, желающий сделать жизни простых горожан чуточку проще... за определённую плату, само собой!
				AlreadyInvested1: Много золота, конечно, не бывает, но твоего присутствия мне уже хватило.
				AlreadyInvested2: Извини, но мои карманы уже полны.
				AlreadyInvested3: Твоя удача уже переходит все границы.
				AlreadyInvested4:  Не жадничай, если не хочешь повторить историю того парня из Греции.
				PlayerHasNoMoney1: Прости, но я не оформляю займы! Возвращайся когда станешь чуточку... побогаче.
				PlayerHasNoMoney2: Я благотворительностью не занимаюсь, знаешь ли...
				PlayerHasNoMoney3: Сначала деньги, потом сделка.
				PlayerHasNoMoney4: Нет, я не принимаю оплату купонами.
				FirstTimeInvested1: Феррагамо Голд!
				FirstTimeInvested2: Какая удача! С этой сделкой мы вместе стали богаче.
				FirstTimeInvested3: Сегодня твой удачный день!
				FirstTimeInvested4: Прекрасное вложение! Везунчик ты мой!
				WhenInvested1: Время - деньги. Так что возвращайся завтра и потрать их ещё!
				WhenInvested2: Поверь мне, это точно не финансовая пирамида.
				WhenInvested3: Увеличение капитала в процессе...
				WhenInvested4: Сколько раз я должен повторять? Никаких возвратов!
				WhenInvested5: Где моя ручка? Ты что, забрал её после подписания договора?!
				WhenInvested6: Приятно иметь с тобой дело! Возвращайся завтра, и я продлю нашу сделку.
				WhenInvested7: Прошу тебя, хватит уже спрашивать у меня про инфляцию!
				WhenInvested8: Покупай! Нет-нет, сливай! А, это опять ты.
				Quote1: Договор дороже денег? Ну уж нет, тогда я бы оставил его при себе.
				Quote2: Если бы мне дали по пять копеек за каждого монстра, что я успел повстречать прошлой ночью, я бы стал ещё богаче и чуть меньше боялся.
				Quote3: Эти тупоголовые слизни всё ещё пытаются проглотить весь мой капитал!
				Quote4: В этом мире мне непонятно лишь одно. Почему монеты круглые, а все остальное - такое квадратное?
				Quote5: Я чувствую себя таким чистым, прямо как денежная машина! 
				Quote7: Эй, одно я могу вам пообещать: я никогда не прошу своих клиентов судить меня по моим победителям. Я прошу их судить обо мне по моим неудачникам, потому что их у меня так мало.
				Quote6: Знаешь, что мне нравится в золоте? Его количество в моих карманах!
				Quote8: Когда эти редкие блоки земли когда-нибудь вырастут в цене, я заработаю на них миллионы!
				Quote9: Хочешь совет по финансам? Не используй ту мерзкую пушку, стреляющую монетами.
				Quote10: Биткоин? Это та штука, делающая крутые биты?
			}

			AlbinoSwarmer: {
				DisplayName: Муравьиный роитель-альбинос
				Bestiary: Может муравьиные львы-альбиносы и не могут сливаться с пейзажами дюн, как это делают их обыкновенные собратья, но одного лишь взгляда на их бледные тела уже достаточно, чтобы заставить любую дичь бояться.
			}

			GiantAlbinoSwarmer: {
				DisplayName: Большой муравьиный роитель-альбинос
				Bestiary: Может, муравьиные львы-альбиносы и не могут сливаться с пейзажами дюн, как это делают их обыкновенные собратья, но одного лишь взгляда на их бледные тела уже достаточно, чтобы заставить любую дичь бояться.
			}
		}

