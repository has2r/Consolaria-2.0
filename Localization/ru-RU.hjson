		Configs: {
			ConsolariaConfig: {
				DisplayName: Конфигурация

				Headers: {
					SeasonalEvents: Сезонные события
					Miscellaneous: Другое
					WorldGeneration: Создание мира
				}

				easterEnabled: {
					Label: Ограничить контент Пасхи по системной дате
					Tooltip: Предметы и враги, связанные с Пасхой, будут доступны только с 1 по 30 апреля.
				}

				thanksgivingEnabled: {
					Label: Ограничить контент Дня благодарения по системной дате
					Tooltip: Предметы и враги, связанные со Днём благодарения, будут доступны только с 1 по 30 ноября.
				}

				smallEventsEnabled: {
					Label: Ограничить другой сезонный контент по системной дате
					Tooltip: Предметы и враги, связанные с другими событиями, будут доступны только на соответствующие праздники или при использовании Кости желаний.
				}

				vanillaBossMusicEnabled: {
					Label: Использовать ванильную музыку для боссов мода
					Tooltip: Заменяет новые музыкальные треки боссов на те, что изначально использовались в консольных версиях.
				}

				tizonaZenithIntegrationEnabled: {
					Label: Интегрировать Тизону в Зенит
					Tooltip: Тизона будет использоваться в рецепте Зенита, а также её будет видно среди других мечей во время его атаки.
				}

				oktoberLocksEnabled: {
					Label: Октоберские пряди у портного
					Tooltip: Портной будет продавать октоберские пряди во время Октоберфеста.
				}

				mythicalWyvernKiteVanillaDropruleEnabled: {
					Label: Ванильное выпадение воздушного змея - мифической виверны
					Tooltip: Вместо красного конверта, воздушный змей - мифическая виверна будет выпадать с шансом 4% из мифической виверны.
				}

				heartbeatariaIntegrationEnabled: {
					Label: Интеграция мода Heartbeataria
					Tooltip: Некоторые предметы из Heartbeataria можно будет получить из красных конвертов.
				}

				originalAncientHeroSetRecipeEnabled: {
					Label: Оригинальный рецепт древнего костюма героя
					Tooltip: Древний костюм героя будет создаваться из шёлка и фиолетовых ниток на ткацком станке, вместо трансмутации в мерцании.
				}

				genderRestrictShopEnabled: {
					Label: Ограничить продажу розовых костюмов по полу персонажа
					Tooltip:
						'''
						Во время кровавой луны, портной будет продавать розовые костюмы в зависимости от пола персонажа:
						Мужской - костюм Джорджа.
						Женский - Потрясающий костюм.
						'''
				}

				pyramidEnabled: {
					Label: Гарантированная пирамида
					Tooltip: При создании мира всегда будет генерироваться как минимум одна пирамида.
				}

				pyramidMessageLoot: {
					Label: Особые предметы в пирамиде
					Tooltip: При включении в сундуке тайной комнаты пирамиды появится зашифрованное сообщение.
				}
			}
		}

		Achievements: {
			LepusKillAchievement: {
				FriendlyName: Двух зайцев одним выстрелом
				Description: Одержать победу над Лепусом - пасхальным баламутом-переростком.
			}

			OcramKillAchievement: {
				FriendlyName: Мракобесие
				Description: Одержать победу над Окрамом - проклятым демоном, скрывающимся под покровом ночи.
			}

