					Кружится на месте, разбрасывая теневые косы 
					Чрезмерное использование этого оружия изматывает вас, значительно снижая его урон 
					Убийство восстанавливает часть изматывания 
					'''
			}

			JadeSeal: {
				DisplayName: Нефритовая печать
				Tooltip:
					'''
					При нажатии ЛКМ призывает нефритовую лампу, которая увеличивает урон и защиту всех союзников внутри её ауры 
					При нажатии ПКМ призывает золоту лампу, которая парит на месте и исцеляет всех союзников внутри её ауры 
					'''
			}

			Omunikodo: {
				DisplayName: Омуникодо
				Tooltip: Выпускает волну хаотичных звуков
			}

			PortableSpecialCorn: {
				DisplayName: Портативная особая кукуруза
				Tooltip: Повторяет каждую четвертую симфоническую атаку, нанося 50% урона
			}

			UtensilPoker: {
				DisplayName: Кухонный протыкатель
				Tooltip:
					'''
					При нажатии ПКМ приготавливает до 5 метательных вилок 
					Вилки застревают во врагах, вызывая кровотечение 
					Чрезмерное использование этого оружия изматывает вас, значительно снижая его урон
					Убийство восстанавливает часть изматывания
					'''
			}

			Chocoplotion: {
				DisplayName: Шоковзрыв
				Tooltip:
					'''
					Прыгает в сторону врага и разрывается шоколадными кусочками Hops towards an enemy and explodes into chocolate droplets
					Чрезмерное использование изматывает вас, значительно снижая его урон
					Убийство восстанавливает часть изматывания
					'''
			}

			FiveStarBuffet: {
				DisplayName: Пятизвёздочный буфет
				Tooltip:
					'''
					Приготавливает до 5 сочных блюд, после чего кормит ими союзников с наименьшим количеством здоровья
					Если у вас наименьшее количество здоровья, лечит вас с уменьшенной эффективностью
					'''
			}

			AlbinoSwarmerBanner: {
				DisplayName: Знамя роевика-альбиноса
				Tooltip: "{$CommonItemTooltip.BannerBonus}Albino Swarmer"
			}

			BleachCanister: {
				DisplayName: Банка с отбеливателем
				Tooltip: Призывает альбиноса-недоростка
			}
		}

		NPCs: {
			AlbinoAntlion: {
				DisplayName: Муравьиный лев-альбинос
				Bestiary: Вид муравьиных львов с редкой мутацией, проявляющий большую агрессивность, возможно, чтобы компенсировать чувствительность к солнечному свету.
			}

			AlbinoCharger: {
				DisplayName: Муравьиный воитель-альбинос
				Bestiary: Иногда муравьиные воители мутируют, теряя свою окраску и становясь более свирепыми, чем их собратья по рою.
			}

			ArchDemon: {
				DisplayName: Архидемон
				Bestiary: Особенно сильные демоны живут так долго, что их тела превращаются в иссушенную оболочку.
			}

			ArchWyvernHead: {
				DisplayName: Архививерна
				Bestiary: Легенды гласят, что виверны способны извергать огонь. Но они умалчивают, что лишь немногие из них доживают до возраста, когда могут обрести такую ​​силу.
			}

			ArchWyvernBody1.DisplayName: Архививерна
			ArchWyvernBody2.DisplayName: Архививерна
			ArchWyvernBody3.DisplayName: Архививерна
			ArchWyvernLegs.DisplayName: Архививерна
			ArchWyvernTail.DisplayName: Архививерна
			BigEgg.DisplayName: Яйцо Лепуса
			ChocolateEgg.DisplayName: Шоколадное яйцо

			DisasterBunny: {
				DisplayName: Пасхальный заяц
				Bestiary: Чудовищное порождение гигантского кролика. Эти пучеглазые создания кусают всё, что встречается на их пути.
			}

			Lepus: {
				DisplayName: Лепус
				Bestiary: Как будто его размеров было недостаточно, так этот кролик способен размножаться с помощью разноцветных яиц, которые весной разлетаются по всему миру, а глупцы, в свою очередь, могут их подобрать.

				BossChecklistIntegration: {
					SpawnInfo: Используйте [i:Consolaria/SuspiciousLookingEgg]
					DespawnMessage: Лепус упрыгивает в рассвет!
				}
			}

			SmallEgg.DisplayName: Яйцо Лепуса

			Ocram: {
				DisplayName: Окрам
				Bestiary: Этот забытый, гниющий демон однажды был императором тьмы. Теперь он ищет мести против всех жителей поверхности.

				BossChecklistIntegration: {
					SpawnInfo: Используйте [i:5643] ночью
					DespawnMessage: Окрам исчезает обратно в тень!
				}
			}

			ServantofOcram: {
				DisplayName: Прислужник Окрама
				Bestiary: Злобные существа, управляемые Окрамом и призванные им же для защиты своего хозяина любыми способами.
			}

			TurkorNeck.DisplayName: Шея Туркора

			TurkortheUngrateful: {
				DisplayName: Туркор Неблагодарный
				Bestiary: Это чудовище, существующее на чистой злобе, ежегодно проводит вендетту против тех, кто осмеливается откусить кусочек индейки на День благодарения.

				BossChecklistIntegration: {
					EntryName: Туркор Неблагодарный
					SpawnInfo: Используйте [i:5641] когда за вами следует Индейка
					DespawnMessage: Туркор Неблагодарный сбегает с обеденной тарелки!
				}
			}

			TurkortheUngratefulHead.DisplayName: Голова Туркора Неблагодарного

			DragonHornet: {
				DisplayName: Драконий шершень
				Bestiary: Являясь родственниками обычных шершней, эти сменили свой облик, чтобы отпугивать врагов. Если же этого недостаточно, то их ядовитые жала должны сработать.
			}

			DragonSkull: {
				DisplayName: Драконий череп
				Bestiary: Затронутые некромантическими заклинаниями, головы древних рептилий теперь охотятся на живых, разделяя проклятие со своими жертвами
			}

			DragonSnatcher: {
				DisplayName: Драконий хвататель
				Bestiary: Эти виды хватателей научились использовать жала шершней, ставших их жертвами, чтобы охотиться на более крупные цели 
			}

			FleshAxe: {
				DisplayName: Топор из поти
				Bestiary: Заколдованное коллективом Багрянца, это оружие передвигается и рубит своих врагов по собственной воле.
			}

			FleshMummy: {
				DisplayName: Мумия из плоти
				Bestiary: С трансформацией песков внешними силами, те, кто был захоронен в пустыни, будь то добрые или злые, чтобы калечить и убивать.
			}

			FleshSlime: {
				DisplayName: Слизень из плоти
				Bestiary: Пропитанные силой Багрянца, эти слизни могут разбрасывать свои выделения. 
			}

			GiantAlbinoCharger: {
				DisplayName: Большой муравьиный воитель-альбинос
				Bestiary: Иногда муравьиные воители мутируют, теряя свою окраску и становясь более свирепыми, чем их собратья по рою.
			}

			MythicalWyvernHead: {
				DisplayName: Мифическая Виверна
				Bestiary: Легендарные существа, эти виверны-затворники приходят в определённое время года. 
			}

			MythicalWyvernBody.DisplayName: Мифическая Виверна
			MythicalWyvernBody2.DisplayName: Мифическая Виверна
			MythicalWyvernBody3.DisplayName: Мифическая Виверна
			MythicalWyvernLegs.DisplayName: Мифическая Виверна
			MythicalWyvernTail.DisplayName: Мифическая Виверна

			Orca: {
				DisplayName: Касатка
				Bestiary: Так как в океанах киты не водятся, эти чёрно-белые хищники охотятся на всё, что движется... включая вас!
			}

			ShadowHammer: {
				DisplayName: Теневой молот
				Bestiary: Заколдованное чистой ненавистью искажения, это орудие беспорядочно мечется от места к месту, пытаясь прибить всё, что дышит.
			}

			ShadowMummy: {
				DisplayName: Теневая мумия
				Bestiary: С трансформацией песков внешними силами, те, кто был захоронен в пустыни, будь то добрые или злые, чтобы калечить и убивать.
			}
			}

			ShadowSlime: {
				DisplayName: Теневой слизень
				Bestiary:Пропитанные силой Порчи, эти слизни могут разбрасывать свои выделения.
			}

			SpectralElemental: {
				DisplayName: Спектральный элементаль
				Bestiary: Иногда вышедшие духи света превращают элементалей хаоса в более могущественных существ, позволяя им проходить сквозь ткань реальности пока они размещают взрывные спектральные руны.
			}

			SpectralGastropod: {
				DisplayName: Спектральный брюхоног
				Bestiary: Когда-то они были самыми обычными брюхоногим. Эти слизни, одержимые эссенцией, могут плеваться в своих врагов сферами концентрированной энергии света.
			}

			SpectralMummy: {
				DisplayName: Спектральная мумия
				Bestiary: Энергия света, переполняющая этих мумий, сделал их и так изношенные тела ещё более нестабильными.
			}

			VampireMiner: {
				DisplayName: Шахтёр-вампир
				Bestiary: Похоже, перед смертью, некоторых шахтёров успели покусать летучие мыши-вампиры... И теперь их гнилые останки бродят, жаждая поживиться чей-нибудь кровью.
			}

			McMoneypants: {
				DisplayName: Мак МаниПэнтс
				// Bestiary: Яркая и харизматичная личность, Мак МаниПэнтс прекрасный богатей, желающий сделать жизни простых горожан чуточку проще... за определённую стоимость, само собой!
				// AlreadyInvested1: Много золота конечно не бывает, но на сегодня с меня хватит.
				// AlreadyInvested2: Извини, но ты уже до этого успел наполнить мои карманы своими денежками.
				// AlreadyInvested3: Твоя удача уже переходит все границы.
				// AlreadyInvested4:  Не будь таким жадиной, ну разве что если ты не хочешь стать тем самым мужиком из Греции.
				// PlayerHasNoMoney1: Прости, но тебе сделку я одобрить не могу! Возвращайся когда станешь чуточку... побогаче.
				// PlayerHasNoMoney2: Я благотворительность не занимаюсь, знаешь ли...
				// PlayerHasNoMoney3: Сначала деньги, потом сделка.
				// PlayerHasNoMoney4: Нет, я не принимаю купонами.
				// FirstTimeInvested1: Феррагамо голд!
				// FirstTimeInvested2: Наша сделка заключена, твоя удача стала чуточку больше.
				// FirstTimeInvested3: Сегодня такой удачный день!
				// FirstTimeInvested4: Прекрасное вложение! Везунчик ты мой!
				// WhenInvested1: Время - деньги. Так, что возвращайся завтра и потрать их ещё!
				// WhenInvested2: Поверь мне, это точно НЕ финансовая пирамида.
				// WhenInvested3: Увеличение капитала в процессе...
				// WhenInvested4: Сколько раз я должен повторять? Никаких возвратов!
				// WhenInvested5: Где моя ручка? Ты что, забрал её у меня после подписания договора?!
				// WhenInvested6: Приятно иметь с вами дело! Возвращайтесь завтра, и я продлю нашу сделку.
				// WhenInvested7: Прошу тебя, хватит уже спрашивать у меня про инфляцию!
				// WhenInvested8: Качай! Нет-нет, выливай! А, это опять ты.
				// Quote1: Честно, копеечка за мои размышления - не так уж и много.
				// Quote2: Если бы мне давали по пять копеек за каждого монстрюгу, что я успел повстречать прошлой ночью, я бы стал ещё богаче и чуть меньше боялся.
				// Quote3: Эти тупоголовые слизни всё ещё пытаются проглотить весь мой капитал!
				// Quote4: Если мир вращается из-за денег, то это место действительно выглядит очень бедным. Давайте изменим это!
				// Quote5: Я чувствую себя таким чистым, как та денежная машина! 
				// Quote6: Знаешь, что мне нравится в золоте? Его количество в моих карманах!
				// Quote7: Эй, одно я могу вам пообещать: я никогда не прошу своих клиентов судить меня по моим победителям. Я прошу их судить обо мне по моим неудачникам, потому что их у меня так мало.
				// Quote8: Если эти раритетные блоки земли когда-нибудь вырастут в цене, я смогу заработать миллионы на них!
				// Quote9: Хочешь совет по финансам? Не использую ту мерзкую штуку, стреляющую монетами.
				// Quote10: Биткоин? Это та штука, делающая крутые биты?
			}

			AlbinoSwarmer: {
				DisplayName: Роевик-альбинос
				// Bestiary: Может муравьиные львы-альбиносы и не могут сливаться с пейзажами дюн, как это делают их более частые собратья, но одного лишь взгляда на их бледные тела уже достаточно, чтобы заставить любую дичь бояться.
			}

			GiantAlbinoSwarmer: {
				DisplayName: Большой роевик-альбинос
				// Bestiary: Может муравьиные львы-альбиносы и не могут сливаться с пейзажами дюн, как это делают их более частые собратья, но одного лишь взгляда на их бледные тела уже достаточно, чтобы заставить любую дичь бояться.
			}
		}

